PORT=3000
# 1 = jeton gratis pou teste (bonis 1,000 + depo demo). Mete 0 an pwodiksyon.
DEMO_MODE=1
# Fichye done (ranplase ak PostgreSQL an pwodiksyon). Nan Docker, se /app/data/db.json (volim ludo-data).
DB_FILE=./data/db.json
# Domèn ki gen dwa konekte si kliyan an sou yon lòt sit
CORS_ORIGIN=

# --- Docker / Proxmox ---
# Pò sou machin lan pou rezo lokal la (http://IP:3000)
LAN_PORT=3000
# Token tinèl Cloudflare (Zero Trust → Networks → Tunnels → Create → Docker). PA JANM komite l.
CLOUDFLARE_TUNNEL_TOKEN=
